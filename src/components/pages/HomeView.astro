---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AmbientGlow from '../AmbientGlow.astro';
import SectionNav from '../SectionNav.astro';
import EdgeTelemetryScript from '../scripts/EdgeTelemetryScript.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { siteConfig } from '../../site.config';
import { themeConfig } from '../../theme.config';
import { pictureLogs, pictureLogsMap, comparePhotoPathsByDateDesc } from '../../utils/pictureLogs';
import { photoImageModules, loadPhotoImage } from '../../utils/photoImages';
import { isFeatureEnabled, isUrlEnabled } from '../../utils/features';

const showPhotos = isFeatureEnabled('photography');

const carouselCount = themeConfig.pagination.homepageCarouselCount;

// Sort photos by publication date descending (newest first, e.g. 2026 -> 2016)
const sortedImageEntries = showPhotos
  ? Object.entries(photoImageModules).sort(([pathA], [pathB]) =>
      comparePhotoPathsByDateDesc(pathA, pathB),
    )
  : [];

const featuredPhotos = showPhotos
  ? await Promise.all(
      sortedImageEntries.slice(0, carouselCount).map(async ([path, imageImporter]) => {
        const { default: imageData } = await imageImporter();
        const filename = path.split('/').pop() ?? '';
        const photo = pictureLogsMap.get(filename);
        const altText = photo ? `${photo.title} — ${photo.location}` : 'Moment from life in Japan';
        return {
          imageData,
          altText,
          photo,
        };
      }),
    )
  : [];

const homeEntry = await getEntry('pages', 'home');
const homeData = homeEntry!.data;
const pageTitle = homeData.pageTitle;
const description = homeData.description;
const intro = homeData.intro!;
const photosSection = homeData.photosSection!;

const heroConfig = themeConfig.hero;
const heroStyle = heroConfig?.style ?? 'classic';
const isMetricsHero = heroStyle === 'metrics';
const heroEyebrow = heroConfig?.eyebrow ?? intro.eyebrow;
const heroHeading = heroConfig?.heading ?? intro.heading;
const heroLeadHighlight = heroConfig?.leadHighlight;
const heroLead = heroConfig?.lead ?? intro.leftColumn;
const heroMetrics = heroConfig?.metrics ?? [];
const rawHeroActions =
  heroConfig?.actions && heroConfig.actions.length > 0
    ? heroConfig.actions
    : [{ label: intro.ctaLabel, href: intro.ctaHref, variant: 'primary' as const }];
const heroActions = rawHeroActions.filter((action) => isUrlEnabled(action.href));
const showHeroTelemetry = Boolean(isMetricsHero && heroConfig?.telemetry?.enabled);

const metricGridColsClass =
  heroMetrics.length === 1
    ? 'grid-cols-1'
    : heroMetrics.length === 2
      ? 'grid-cols-2'
      : heroMetrics.length === 3
        ? 'grid-cols-2 lg:grid-cols-3'
        : 'grid-cols-2 lg:grid-cols-4';

const metricAccentClasses: Record<'default' | 'amber' | 'emerald', string> = {
  default: 'text-gray-900 dark:text-white',
  amber: 'text-amber-700 dark:text-amber-500',
  emerald: 'text-emerald-700 dark:text-emerald-400',
};

const heroActionClasses: Record<'primary' | 'secondary' | 'ghost', string> = {
  primary:
    'inline-flex items-center gap-1.5 rounded-lg bg-amber-500 px-4 py-2.5 text-sm font-semibold text-gray-950 shadow-xs hover:bg-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 transition-colors',
  secondary:
    'inline-flex items-center rounded-lg bg-gray-900/5 dark:bg-white/10 px-4 py-2.5 text-sm font-semibold text-gray-900 dark:text-white ring-1 ring-inset ring-gray-900/10 dark:ring-white/15 hover:bg-gray-900/10 dark:hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 transition-colors',
  ghost:
    'inline-flex items-center gap-1.5 px-2 py-2 text-sm font-semibold text-gray-700 hover:text-amber-700 dark:text-gray-300 dark:hover:text-amber-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-500 rounded-md transition-colors',
};

const homeSections = [
  { id: 'intro', label: 'Intro' },
  ...(showPhotos ? [{ id: 'photos', label: 'Photos' }] : []),
];
---

<BaseLayout
  pageTitle={pageTitle}
  description={description}
  image="/og/home.jpg"
  imageAlt={siteConfig.author.name}
>

{homeSections.length > 1 && (
  <SectionNav sections={homeSections} slot="breadcrumb-extra" ariaLabel="Homepage sections" />
)}

<!-- blurb / hero section with ambient hue background -->

<div id="intro" class="scroll-mt-16 relative isolate overflow-hidden py-20 sm:py-28">
  <AmbientGlow preset="home-top" />

  <div class="mx-auto max-w-7xl px-6 lg:px-8 space-y-10">
    <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none rounded-2xl p-8 sm:p-12 shadow-lg ring-1 ring-gray-900/5 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm dark:ring-white/10">
      {isMetricsHero ? (
        <>
          <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-amber-700 dark:text-amber-500">{heroEyebrow}</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl sm:leading-[1.12]">{heroHeading}</h1>
          <p class="mt-5 text-base/7 sm:text-lg/8 text-gray-600 dark:text-gray-300">
            {heroLeadHighlight && (
              <>
                <strong class="font-semibold text-gray-900 dark:text-white">{heroLeadHighlight}</strong>{' '}
              </>
            )}
            {heroLead}
          </p>

          {heroMetrics.length > 0 && (
            <dl class={`mt-8 grid ${metricGridColsClass} gap-6 sm:gap-8 border-y border-gray-200/80 dark:border-gray-700/70 py-6`}>
              {heroMetrics.map((metric) => (
                <div class="flex flex-col-reverse">
                  <dt class="mt-1 text-xs sm:text-sm text-gray-600 dark:text-gray-400">{metric.label}</dt>
                  <dd class={`text-2xl sm:text-3xl font-semibold tracking-tight tabular-nums ${metricAccentClasses[metric.accent ?? 'default']}`}>
                    {metric.value}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          {(heroActions.length > 0 || showHeroTelemetry) && (
            <div class="mt-8 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              {heroActions.length > 0 && (
                <div class="flex flex-wrap items-center gap-3">
                  {heroActions.map((action) => (
                    <a href={action.href} class={heroActionClasses[action.variant ?? 'secondary']}>
                      <span>{action.label}</span>
                      {(action.variant === 'primary' || action.variant === 'ghost') && (
                        <span aria-hidden="true">&rarr;</span>
                      )}
                    </a>
                  ))}
                </div>
              )}

              {showHeroTelemetry && (
                <div
                  id="edge-telemetry"
                  class="inline-flex w-fit max-w-full items-center gap-2 rounded-full bg-gray-100/90 dark:bg-gray-900/80 px-3.5 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 ring-1 ring-inset ring-gray-900/10 dark:ring-white/10"
                  aria-live="polite"
                  data-edge-mesh-label={heroConfig?.telemetry?.meshLabel ?? ''}
                >
                  <span class="relative flex size-2 shrink-0" aria-hidden="true">
                    <span data-edge-ping class="hidden absolute inline-flex h-full w-full motion-safe:animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span data-edge-dot class="relative inline-flex size-2 rounded-full bg-amber-500 dark:bg-amber-400"></span>
                  </span>
                  <span data-edge-text>{heroConfig?.telemetry?.fallbackText ?? 'Static Edge Build • CloudFront POP Ready'}</span>
                </div>
              )}
            </div>
          )}
        </>
      ) : (
        <>
          <p class="text-base/7 font-semibold text-amber-700 dark:text-amber-500">{intro.eyebrow}</p>
          <h1 class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">{intro.heading}</h1>
          <div class="mt-8 grid max-w-xl grid-cols-1 gap-8 text-base/7 text-gray-700 dark:text-gray-300 lg:max-w-none lg:grid-cols-2">
            <div>
              <p>
                {intro.leftColumn}
              </p>
            </div>
            <div class="space-y-4">
              <p>
                {intro.rightColumn}
              </p>
            </div>
          </div>
        </>
      )}
    </div>
  </div>

  <AmbientGlow preset="home-bottom" />
</div>

{showPhotos && (
  <section id="photos" aria-labelledby="home-photo-heading" class="scroll-mt-16 relative isolate overflow-hidden py-24 sm:py-32 transition-colors" data-carousel-container="photos">
    <AmbientGlow preset="home-photos" />
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <h2 id="home-photo-heading" class="text-4xl font-semibold tracking-tight text-pretty text-gray-900 dark:text-white sm:text-5xl">
            {photosSection.heading}
          </h2>
          <p class="mt-2 text-lg/8 text-gray-600 dark:text-gray-400">
            {photosSection.subtitle}{' '}
            <a href="/photography/" class="text-sm/6 font-semibold text-amber-700 hover:text-amber-600 dark:text-amber-500 dark:hover:text-amber-400">
              {photosSection.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0 self-start sm:self-end">
          <span class="carousel-counter text-xs font-medium text-gray-600 dark:text-gray-300 bg-gray-100 dark:bg-gray-800/80 px-2.5 py-1 rounded-full ring-1 ring-inset ring-gray-200 dark:ring-gray-700">
            1–3 of {featuredPhotos.length}
          </span>
          <div class="flex items-center gap-1.5">
            <button
              type="button"
              class="carousel-prev size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-amber-500 hover:text-amber-500 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Previous photos"
              disabled
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>
            <button
              type="button"
              class="carousel-next size-9.5 inline-flex items-center justify-center rounded-full border border-gray-200/80 dark:border-gray-800 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-xs hover:border-amber-500 hover:text-amber-500 dark:hover:border-amber-500 dark:hover:text-amber-400 transition-colors disabled:opacity-35 disabled:cursor-not-allowed cursor-pointer"
              aria-label="Next photos"
            >
              <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <div class="relative mt-12 sm:mt-14 border-t border-gray-200/80 dark:border-gray-800 pt-12 sm:pt-14">
        <div
          class="carousel-track no-scrollbar flex gap-8 overflow-x-auto scroll-smooth snap-x snap-mandatory pt-2 pb-6 focus:outline-hidden"
          tabindex="0"
          aria-label="Photo Roll carousel"
        >
          {featuredPhotos.map(({ imageData, altText, photo }) => (
            <div class="carousel-item snap-start shrink-0 w-[85%] sm:w-[calc((100%-2rem)/2)] lg:w-[calc((100%-4rem)/3)] flex flex-col">
              <a href={photo ? `/photography/?photo=${photo.id}` : '/photography/'} class="group block h-full">
                <div class="border-beam-card relative w-full h-full overflow-hidden rounded-2xl bg-white dark:bg-gray-800 shadow-lg ring-1 ring-gray-900/5 dark:ring-white/10 transition-all duration-300 hover:shadow-xl">
                  <Image
                    src={imageData}
                    alt={altText}
                    widths={[320, 384, 512, 640]}
                    sizes="(min-width: 1024px) 384px, (min-width: 640px) 45vw, 85vw"
                    quality={60}
                    loading="lazy"
                    decoding="async"
                    class="aspect-video w-full h-full rounded-2xl bg-gray-100 dark:bg-gray-700 object-cover sm:aspect-2/1 lg:aspect-3/2 transition-transform duration-300 group-hover:scale-[1.02]"
                  />
                </div>
              </a>
            </div>
          ))}
        </div>

        <div class="carousel-dots mt-3 flex items-center justify-center gap-0.5" role="group" aria-label="Photo carousel pagination">
          {featuredPhotos.map((_, i) => (
            <button
              type="button"
              class="carousel-dot group/dot inline-flex min-h-6 min-w-6 items-center justify-center px-1 cursor-pointer rounded-full focus:outline-hidden focus-visible:ring-2 focus-visible:ring-amber-500"
              data-index={i}
              aria-label={`Go to photo ${i + 1}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span
                class={`carousel-dot-indicator block h-1.5 rounded-full transition-all duration-300 ${
                  i === 0
                    ? 'w-6 bg-amber-500 dark:bg-amber-400 shadow-xs'
                    : 'w-2 bg-gray-300 dark:bg-gray-700 group-hover/dot:bg-gray-400 dark:group-hover/dot:bg-gray-600'
                }`}
              />
            </button>
          ))}
        </div>
      </div>

      <div class="mt-10 sm:mt-12 flex justify-end">
        <a
          href="/photography/"
          class="group inline-flex items-center gap-1.5 text-sm/6 font-semibold text-amber-700 hover:text-amber-600 dark:text-amber-500 dark:hover:text-amber-400 transition-colors"
        >
          <span>{photosSection.footerLinkLabel}</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
)}

{showHeroTelemetry && <EdgeTelemetryScript />}
</BaseLayout>
